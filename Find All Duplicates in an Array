class Solution {
public:
    vector<int> findDuplicates(vector<int>& nums) {
        int n = nums.size();

        unordered_map<int, int> freq;

        for(int num : nums){
            freq[num]++;
        }

        vector<int> result;
        for(auto &it: freq){
            if(it.second > 1) result.push_back(it.first);
        }

        return result;
    }
};

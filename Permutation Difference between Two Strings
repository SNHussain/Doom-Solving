class Solution {
public:
    int findPermutationDifference(string s, string t) {
        int n = s.length();

        unordered_map<char,int> posS; //character, index
        unordered_map<char,int> posT; //character, index


        for(int i=0; i<s.length(); i++){
            posS[s[i]] = i;
        }
        for(int i=0; i<t.length(); i++){
            posT[t[i]] = i;
        }

        int sum = 0;
        for(int i=0; i<n; i++){
            sum += abs(posS[s[i]] - posT[s[i]]);
        }

        return sum;
    }
};

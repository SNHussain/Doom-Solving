class Solution {
public:
    char findTheDifference(string s, string t) {
        char c;

        int n = t.length();

        unordered_map<int , int> freq;

        for(char ch: s){
            freq[ch]++;
        }

        for(char ch: t){
            if(freq[ch] > 0){
                freq[ch]--;
            }
            else{
                c = ch;
            }
        }

        return c;
    }
};

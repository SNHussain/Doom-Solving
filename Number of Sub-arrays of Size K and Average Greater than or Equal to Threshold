class Solution {
public:
    int numOfSubarrays(vector<int>& nums, int k, int threshold) {
        int n = nums.size();

        //first window
        int sum = 0;
        for(int i=0; i<k; i++){
            sum += nums[i];

        }

        int count = 0;
        if(sum/k >= threshold){
            count++;
        }

        //fixed window
        for(int i=k; i<n; i++){
            sum += nums[i];
            sum -= nums[i-k];

            if(sum/k >= threshold) count++;
        }

        return count;
    }
};

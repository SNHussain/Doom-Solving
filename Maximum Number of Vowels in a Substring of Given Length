class Solution {
public:
    int countVowel(string check){
        int n = check.length();

        int count = 0;

        for(int i=0; i<n; i++){
            char ch = check[i];
            if(ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u' ){
                count++;
            }
        }

        return count;
    }
    int maxVowels(string s, int k) {
        int n = s.length();

        //first window
        string check = "";
        
        for(int i=0; i<k; i++){
            check += s[i];
           
        }
        int count = countVowel(check);

        //fixed window
        int maxi = count;
        for(int i=k; i<n; i++){
            check += s[i];
            check.erase(0,1);

            int x = countVowel(check);
            maxi = max(maxi, x);
        }

        return maxi;
    }
};




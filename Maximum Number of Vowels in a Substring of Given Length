class Solution {
public:
    bool isVowel(char ch){

        if(ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u' ){
                return true;
            }

        return false;
    }
    int maxVowels(string s, int k) {
        int n = s.length();

        //first window
        string check = "";

        int count = 0;
        
        for(int i=0; i<k; i++){
            if(isVowel(s[i])){
                count++;
            }
           
        }
       

        //fixed window
        int maxi = count;
        for(int i=k; i<n; i++){
            if(isVowel(s[i])){
                count++;
            }

            if(isVowel(s[i-k])){
                count--;
            }

            maxi = max(maxi , count);
            
        }

        return maxi;
    }
};

class Solution {
public:
    bool containsDuplicate(vector<int>& nums) {
        unordered_map<int, int> mp;

        int n = nums.size();

        for(int &num : nums){
            mp[num]++;
        }

        for(int i=0; i<n; i++){
            if(mp[i].second>1) return true;
        }

        return false;
    }
};
